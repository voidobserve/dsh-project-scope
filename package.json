{
  "name": "dsh-project-scope",
  "version": "0.1.1",
  "description": "把 DeepSeek Harness 的侧边栏改成单工程视图：顶部是工程切换器，下面只列当前工程的会话。",
  "author": "voidobserve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidobserve/dsh-project-scope.git"
  },
  "homepage": "https://github.com/voidobserve/dsh-project-scope#readme",
  "bugs": {
    "url": "https://github.com/voidobserve/dsh-project-scope/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "workspace",
    "session",
    "project"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node test/render-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
